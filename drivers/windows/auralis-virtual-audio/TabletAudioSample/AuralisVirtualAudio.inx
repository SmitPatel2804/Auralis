[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 08/21/2026, 0.1.0.0
CatalogFile = auralisvirtualaudio.cat
PnpLockDown = 1

[SourceDisksNames]
222="Auralis Virtual Audio Driver Disk","",222

[SourceDisksFiles]
auralisvirtualaudio.sys=222

[SignatureAttributes]
auralisvirtualaudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[Manufacturer]
%MfgName%=Auralis,NT$ARCH$.10.0...22621

[Auralis.NT$ARCH$.10.0...22621]
%Auralis.DeviceDesc%=Auralis.Install, Root\AuralisVirtualAudio

[DestinationDirs]
Auralis.CopyList=13

[Auralis.CopyList]
auralisvirtualaudio.sys

[Auralis.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,auralisvirtualaudio.sys
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Auralis.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%Auralis.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Auralis.DeviceDesc%

[Auralis.I.Wave]
AddReg=Auralis.I.Wave.AddReg

[Auralis.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Auralis.EndpointName%

[Auralis.I.Topology]
AddReg=Auralis.I.Topology.AddReg

[Auralis.I.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Auralis.EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[Auralis.Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Auralis.CopyList
AddReg=Auralis.AddReg

[Auralis.Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,Auralis.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,Auralis.I.Wave
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,Auralis.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,Auralis.I.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,Auralis.I.Topology

[Auralis.Install.NT.Services]
AddService=AuralisVirtualAudio,0x00000002,Auralis.Service

[Auralis.Service]
DisplayName=%Auralis.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\auralisvirtualaudio.sys

[Auralis.Install.NT.HW]
AddReg=Auralis.HardwareSecurity

[Auralis.HardwareSecurity]
HKR,,DeviceType,0x10001,0x0000001D
; The app uses standard WASAPI endpoint loopback. It never opens the kernel
; device directly, so only SYSTEM and administrators need device-object access.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Auralis.Install.NT.Wdf]
KmdfService=AuralisVirtualAudio,Auralis.Wdf

[Auralis.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
ProviderName="Auralis Project"
MfgName="Auralis Project"
Auralis.DeviceDesc="Auralis Virtual Audio Device"
Auralis.ServiceDesc="Auralis Virtual Audio Driver"
Auralis.EndpointName="Auralis Virtual Output"
